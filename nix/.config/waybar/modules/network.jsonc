{
  // Throughput used to live in a separate `network#speed` module on the left.
  // It now rides along in this tooltip, which keeps the right island short and
  // stops the bar shifting every time the numbers change width.
  // `interval` has to stay at 1 for the bandwidth counters to be meaningful.
  "network": {
    "interval": 1,
    "format": "{ifname}",
    "format-wifi": "{icon}  {essid}",
    "format-ethernet": "󰈁  {ipaddr}",
    "format-linked": "󰈁  {ifname}",
    "format-disconnected": "󰖪  Offline",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format": "{ifname} via {gwaddr}\n  {bandwidthDownBytes}    {bandwidthUpBytes}",
    "tooltip-format-wifi": "{essid}  {signalStrength}%\n{ipaddr}/{cidr}\n  {bandwidthDownBytes}    {bandwidthUpBytes}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}/{cidr}\n  {bandwidthDownBytes}    {bandwidthUpBytes}",
    "tooltip-format-disconnected": "󰖪  Disconnected",
    "max-length": 24,
    "on-click": "wpa_gui"
  }
}
